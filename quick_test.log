_ratio': 0.3, 'seed': 42, 'attack_type_mapping': {'Benign': 0.0, 'ICMPFlood': 0.3, 'UDPFlood': 0.4, 'SYNFlood': 0.6, 'HTTPFlood': 0.7, 'SlowrateDoS': 0.8, 'TCPConnectScan': 0.7, 'SYNScan': 0.6, 'UDPScan': 0.5}, 'max_attempts_multiplier': 10, 'quality_threshold': 0.9, 'semantic_ratios': {'ue_flow_ratio': 0.4, 'flow_alert_ratio': 0.3, 'high_risk_ratio': 0.3}}, 'temporal_prediction': {'enabled': True, 'method': 'hetero_lstm', 'window_size': 5, 'stride': 1, 'future_steps': 3, 'lead_time_targets': [5, 10, 15], 'hetero_lstm': {'spatial_encoder_reuse': True, 'graph_aggregation': 'mean_pool', 'lstm_layers': 1, 'bidirectional': False}, 'tgat_risk': {'edge_level_modeling': True, 'risk_bias_temperature': 0.1, 'num_heads': 4, 'time_encoding_dim': 16}, 'graph_rnn': {'node_level_generation': True, 'rnn_type': 'GRU', 'message_passing_steps': 3}}, 'cross_scale_context': {'enabled': True, 'fusion_method': 'gate'}, 'training_enhancements': {'progressive': True, 'base_epochs': 20, 'risk_epochs': 30, 'scheduler': 'cosine', 'early_stopping': {'enabled': True, 'patience': 10, 'min_delta': 0.001}}}, seed=42, device='cpu', num_threads=8, experiment_name='riskniclp_baseline_20250623_181355', experiment_tags=[], notes='Baseline RiskNICLP-5G implementation with CPU optimization and heterogeneous node feature support')
